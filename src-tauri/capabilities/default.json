{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "deep-link:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://*.supabase.co/*" },
        { "url": "https://accounts.google.com/*" },
        { "url": "https://t.me/*" }
      ]
    }
  ]
}
